default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Load API key for App Store Connect from environment variables
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    # Fetch latest build number from TestFlight and increment
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "dev.dreamfold.tabletogether"
    )
    new_build = latest_build + 1

    # Update build number and version directly in pbxproj (agvtool doesn't work with multiple projects)
    sh("sed -i '' 's/CURRENT_PROJECT_VERSION = [0-9]*/CURRENT_PROJECT_VERSION = #{new_build}/' ../TableTogether.xcodeproj/project.pbxproj")
    sh("sed -i '' 's/MARKETING_VERSION = [0-9.]*/MARKETING_VERSION = 1.0.#{new_build}/' ../TableTogether.xcodeproj/project.pbxproj")

    # Build the app
    build_app(
      scheme: "TableTogether",
      export_method: "app-store",
      project: "TableTogether.xcodeproj",
      destination: "generic/platform=iOS",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{File.expand_path(asc_key_path)}' -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}",
      export_options: {
        signingStyle: "automatic",
        teamID: "N6BK2WX94Z"
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and archive without uploading"
  lane :build do
    build_app(
      scheme: "TableTogether",
      export_method: "app-store",
      project: "TableTogether.xcodeproj",
      destination: "generic/platform=iOS"
    )
  end

  desc "Push App Store metadata to App Store Connect"
  lane :metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      metadata_path: "./fastlane/metadata",
      app_version: "1.0.0",
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_app_version_update: true,
      submit_for_review: false,
      force: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      run_precheck_before_submit: false
    )
  end

  desc "Capture App Store screenshots from simulators"
  lane :capture_app_screenshots do
    sh("../scripts/capture_screenshots.sh")
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      screenshots_path: "./fastlane/screenshots",
      force: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Capture and upload App Store screenshots"
  lane :screenshots do
    capture_app_screenshots
    upload_screenshots
  end
end

platform :appletvos do
  desc "Push a new tvOS beta build to TestFlight"
  lane :beta do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "dev.dreamfold.tabletogether.tv",
      platform: "appletvos"
    )
    new_build = latest_build + 1

    # Update build number and version directly in pbxproj (agvtool doesn't work with multiple projects)
    sh("sed -i '' 's/CURRENT_PROJECT_VERSION = [0-9]*/CURRENT_PROJECT_VERSION = #{new_build}/' ../TableTogetherTV.xcodeproj/project.pbxproj")
    sh("sed -i '' 's/MARKETING_VERSION = [0-9.]*/MARKETING_VERSION = 1.0.#{new_build}/' ../TableTogetherTV.xcodeproj/project.pbxproj")

    build_app(
      scheme: "TableTogetherTV",
      export_method: "app-store",
      project: "TableTogetherTV.xcodeproj",
      destination: "generic/platform=tvOS",
      xcargs: "-allowProvisioningUpdates -authenticationKeyPath '#{File.expand_path(asc_key_path)}' -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}",
      export_options: {
        signingStyle: "manual",
        teamID: "N6BK2WX94Z",
        provisioningProfiles: {
          "dev.dreamfold.tabletogether.tv" => "dev.dreamfold.tabletogether.tv AppStore"
        }
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and archive tvOS without uploading"
  lane :build do
    build_app(
      scheme: "TableTogetherTV",
      export_method: "app-store",
      project: "TableTogetherTV.xcodeproj",
      destination: "generic/platform=tvOS"
    )
  end

  desc "Push tvOS metadata to App Store Connect"
  lane :metadata do
    deliver(
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      metadata_path: "./fastlane/metadata-tvos",
      app_version: "1.0.0",
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      app_identifier: "dev.dreamfold.tabletogether.tv",
      platform: "appletvos"
    )
  end

  desc "Build, upload, and push metadata for tvOS"
  lane :release do
    beta
    metadata
  end
end
