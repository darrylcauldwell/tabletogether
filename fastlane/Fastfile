default_platform(:ios)

platform :ios do
  desc "Push a new beta build to TestFlight"
  lane :beta do
    # Load API key for App Store Connect from environment variables
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    # Fetch latest build number from TestFlight and increment
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "dev.dreamfold.tabletogether"
    )
    new_build = latest_build + 1

    # Build the app — version set via xcargs (no agvtool needed)
    build_app(
      scheme: "TableTogether",
      export_method: "app-store",
      project: "TableTogether.xcodeproj",
      destination: "generic/platform=iOS",
      xcargs: "CURRENT_PROJECT_VERSION=#{new_build} MARKETING_VERSION=1.1 -allowProvisioningUpdates -authenticationKeyPath '#{File.expand_path(asc_key_path)}' -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}",
      export_options: {
        signingStyle: "automatic",
        teamID: "N6BK2WX94Z"
      }
    )

    # Upload to TestFlight
    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Push a new Mac Catalyst beta build to TestFlight"
  lane :mac_beta do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    # Mac Catalyst build numbers track independently from iOS in App Store
    # Connect (same app record dev.dreamfold.tabletogether, separate build
    # number space for the macOS platform).
    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "dev.dreamfold.tabletogether",
      platform: "osx"
    )
    new_build = latest_build + 1

    # Build Mac Catalyst — `catalyst_platform: "macos"` is critical. Without
    # it, gym tries to produce an iOS .ipa from the Mac Catalyst archive and
    # fails with "IPA invalid". With it, gym produces a .pkg installer that
    # TestFlight accepts for the macOS tab.
    build_app(
      scheme: "TableTogether",
      export_method: "app-store",
      project: "TableTogether.xcodeproj",
      catalyst_platform: "macos",
      xcargs: "CURRENT_PROJECT_VERSION=#{new_build} MARKETING_VERSION=1.1 -allowProvisioningUpdates -authenticationKeyPath '#{File.expand_path(asc_key_path)}' -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}",
      export_options: {
        signingStyle: "automatic",
        teamID: "N6BK2WX94Z"
      }
    )

    # Upload via altool directly (not pilot). pilot's Mac Catalyst upload
    # path calls altool --upload-app which tries to resolve Apple ID from
    # bundle ID + platform — that lookup fails for any app that has never
    # had a macOS build in App Store Connect with error:
    #   "Cannot determine the Apple ID from Bundle ID ... and platform 'MAC_OS'"
    # altool --upload-package with explicit --apple-id bypasses the lookup
    # entirely. The App Store Connect API key is used for auth. Once this
    # first upload succeeds and creates the macOS platform record in ASC,
    # later runs would work via pilot too, but keeping altool direct keeps
    # the lane deterministic.
    sh(
      "xcrun", "altool", "--upload-package",
      "../TableTogether.pkg",
      "--type", "macos",
      "--asc-public-id", asc_issuer_id,
      "--apple-id", "6758763074",
      "--bundle-id", "dev.dreamfold.tabletogether",
      "--bundle-version", new_build.to_s,
      "--bundle-short-version-string", "1.1",
      "--apiKey", asc_key_id,
      "--apiIssuer", asc_issuer_id
    )
  end

  desc "Build and archive without uploading"
  lane :build do
    build_app(
      scheme: "TableTogether",
      export_method: "app-store",
      project: "TableTogether.xcodeproj",
      destination: "generic/platform=iOS"
    )
  end

  desc "Push App Store metadata to App Store Connect"
  lane :metadata do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      metadata_path: "./fastlane/metadata",
      app_version: "1.1",
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Upload metadata and screenshots to App Store Connect"
  lane :upload_metadata do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_app_version_update: true,
      submit_for_review: false,
      force: true,
      metadata_path: "./fastlane/metadata",
      screenshots_path: "./fastlane/screenshots",
      overwrite_screenshots: true,
      run_precheck_before_submit: false
    )
  end

  desc "Build, upload, and push metadata for iOS"
  lane :release do
    beta
    metadata
  end

  desc "Build, upload, and push metadata for Mac Catalyst"
  lane :mac_release do
    mac_beta
    # Metadata is shared with the iOS App Store listing — the iOS metadata
    # lane covers both platforms. No separate metadata upload needed here.
  end

  desc "Submit latest iOS TestFlight build for App Store review"
  lane :promote do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end

  desc "Submit latest Mac Catalyst TestFlight build for App Store review"
  lane :mac_promote do
    # Mac Catalyst shares the iOS App Store listing — promoting iOS
    # promotes for both platforms. This lane exists for explicit invocation
    # but delegates to the iOS promote lane.
    promote
  end

  desc "Capture App Store screenshots from simulators"
  lane :capture_app_screenshots do
    sh("../scripts/capture_screenshots.sh")
  end

  desc "Upload screenshots to App Store Connect"
  lane :upload_screenshots do
    deliver(
      skip_binary_upload: true,
      skip_metadata: true,
      overwrite_screenshots: true,
      screenshots_path: "./fastlane/screenshots",
      force: true,
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false
    )
  end

  desc "Capture and upload App Store screenshots"
  lane :screenshots do
    capture_app_screenshots
    upload_screenshots
  end
end

platform :appletvos do
  desc "Push a new tvOS beta build to TestFlight"
  lane :beta do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    latest_build = latest_testflight_build_number(
      api_key: api_key,
      app_identifier: "dev.dreamfold.tabletogether.tv",
      platform: "appletvos"
    )
    new_build = latest_build + 1

    # Build tvOS — automatic signing, version set via xcargs
    build_app(
      scheme: "TableTogetherTV",
      export_method: "app-store",
      project: "TableTogetherTV/TableTogetherTV.xcodeproj",
      destination: "generic/platform=tvOS",
      xcargs: "CURRENT_PROJECT_VERSION=#{new_build} MARKETING_VERSION=1.1 -allowProvisioningUpdates -authenticationKeyPath '#{File.expand_path(asc_key_path)}' -authenticationKeyID #{asc_key_id} -authenticationKeyIssuerID #{asc_issuer_id}",
      export_options: {
        signingStyle: "automatic",
        teamID: "N6BK2WX94Z"
      }
    )

    upload_to_testflight(
      api_key: api_key,
      skip_waiting_for_build_processing: true
    )
  end

  desc "Build and archive tvOS without uploading"
  lane :build do
    build_app(
      scheme: "TableTogetherTV",
      export_method: "app-store",
      project: "TableTogetherTV/TableTogetherTV.xcodeproj",
      destination: "generic/platform=tvOS"
    )
  end

  desc "Push tvOS metadata to App Store Connect"
  lane :metadata do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      force: true,
      metadata_path: "./fastlane/metadata-tvos",
      app_version: "1.1",
      submit_for_review: false,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      run_precheck_before_submit: false,
      app_identifier: "dev.dreamfold.tabletogether.tv",
      platform: "appletvos"
    )
  end

  desc "Build, upload, and push metadata for tvOS"
  lane :release do
    beta
    metadata
  end

  desc "Submit latest tvOS TestFlight build for App Store review"
  lane :promote do
    asc_key_id = ENV.fetch("ASC_KEY_ID")
    asc_issuer_id = ENV.fetch("ASC_ISSUER_ID")
    asc_key_path = ENV.fetch("ASC_KEY_PATH")

    api_key = app_store_connect_api_key(
      key_id: asc_key_id,
      issuer_id: asc_issuer_id,
      key_filepath: asc_key_path
    )

    deliver(
      api_key: api_key,
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: true,
      submit_for_review: true,
      automatic_release: false,
      force: true,
      run_precheck_before_submit: false,
      app_identifier: "dev.dreamfold.tabletogether.tv",
      platform: "appletvos",
      submission_information: {
        add_id_info_uses_idfa: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
